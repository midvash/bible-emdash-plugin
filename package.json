{
	"name": "@midvash/emdash-plugin-bible",
	"version": "0.9.0",
	"description": "EmDash plugin: auto-detect Bible references in content and render verse tooltips on hover. Powered by the public Midvash API (https://api.midvash.com).",
	"type": "module",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"cms",
		"bible",
		"midvash",
		"tooltip",
		"verses"
	],
	"license": "MIT",
	"author": "Neto Gregório",
	"homepage": "https://midvash.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/midvash/bible-emdash-plugin.git"
	},
	"bugs": {
		"url": "https://github.com/midvash/bible-emdash-plugin/issues"
	},
	"main": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./sandbox": {
			"types": "./dist/plugin.d.ts",
			"import": "./dist/plugin.js"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"import": "./dist/runtime.js"
		},
		"./middleware": {
			"types": "./dist/middleware.d.ts",
			"import": "./dist/middleware.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"README.pt-BR.md",
		"README.es.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"check": "npm run typecheck && npm run coverage",
		"build": "tsdown src/index.ts src/plugin.ts src/runtime.ts src/middleware.ts --format esm --dts --clean --platform neutral --external emdash --external emdash/plugin --external astro --external zod",
		"bundle": "npm run build && emdash-plugin bundle -o .emdash-bundle-tmp",
		"bundle:validate": "npm run build && emdash-plugin bundle --validate-only -o .emdash-bundle-tmp",
		"changeset": "changeset",
		"version-packages": "changeset version && node scripts/sync-descriptor-version.mjs",
		"release": "changeset publish",
		"prepublishOnly": "npm run check && npm run build"
	},
	"engines": {
		"node": ">=18"
	},
	"peerDependencies": {
		"emdash": ">=0.16.1",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@emdash-cms/plugin-cli": "^0.13.4",
		"@vitest/coverage-v8": "^5.0.5",
		"astro": "^7.4.1",
		"emdash": "^1.3.1",
		"happy-dom": "^21.0.4",
		"tsdown": "^0.23.2",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5",
		"zod": "4.5.4"
	}
}
